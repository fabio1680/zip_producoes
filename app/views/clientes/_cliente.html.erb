<div id="<%= dom_id cliente %>">
  <div>
    <strong>Nome:</strong>
    <%= cliente.nome %>
  </div>

  <div>
    <strong>Cpf:</strong>
    <%= cliente.cpf %>
  </div>

  <div>
    <strong>Telefone:</strong>
    <%= cliente.telefone %>
  </div>

  <div>
    <strong>Whatsapp:</strong>
    <%= cliente.whatsapp %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= cliente.email %>
  </div>

  <div>
    <strong>Endereco:</strong>
    <%= cliente.endereco %>
  </div>

  <div>
    <strong>Cidade:</strong>
    <%= cliente.cidade %>
  </div>

  <div>
    <strong>Estado:</strong>
    <%= cliente.estado %>
  </div>

  <div>
    <strong>Cep:</strong>
    <%= cliente.cep %>
  </div>

  <div>
    <strong>Observacoes:</strong>
    <%= cliente.observacoes %>
  </div>

</div>
