<div class="container">

<div class="d-flex justify-content-between align-items-center mb-4">

<div class="mb-3">

    <%= link_to "⚡ Cadastro Rápido",
        cadastro_rapido_clientes_path,
        class: "btn btn-success" %>

</div>

<h1>
👥 Clientes
</h1>


<%= link_to "➕ Novo Cliente",
new_cliente_path,
class:"btn btn-success"
%>

</div>


<div class="row">

<% @clientes.each do |cliente| %>


<div class="col-md-4 mb-4">


<div class="card shadow rounded-4">


<div class="card-body">


<h4 class="card-title">
<%= cliente.nome %>
</h4>


<p>
📱 <%= cliente.telefone %>
</p>


<p>
📍 <%= cliente.cidade %> - <%= cliente.estado %>
</p>



<div class="mt-3">


<%= link_to "👁 Ver",
cliente,
class:"btn btn-primary btn-sm"
%>


<%= link_to "✏ Editar",
edit_cliente_path(cliente),
class:"btn btn-warning btn-sm"
%>


<%= link_to "🗑 Excluir",
cliente,
data:{
turbo_method: :delete,
turbo_confirm:"Deseja excluir este cliente?"
},
class:"btn btn-danger btn-sm"
%>


</div>


</div>

</div>


</div>


<% end %>


</div>


</div>
