<div id="<%= dom_id evento %>">
  <div>
    <strong>Cliente:</strong>
    <%= evento.cliente_id %>
  </div>

  <div>
    <strong>Tipo:</strong>
    <%= evento.tipo %>
  </div>

  <div>
    <strong>Data:</strong>
    <%= evento.data %>
  </div>

  <div>
    <strong>Hora:</strong>
    <%= evento.hora %>
  </div>

  <div>
    <strong>Local:</strong>
    <%= evento.local %>
  </div>

  <div>
    <strong>Valor:</strong>
    <%= evento.valor %>
  </div>

  <div>
    <strong>Sinal:</strong>
    <%= evento.sinal %>
  </div>

  <div>
    <strong>Restante:</strong>
    <%= evento.restante %>
  </div>

  <div>
    <strong>Situacao:</strong>
    <%= evento.situacao %>
  </div>

  <div>
    <strong>Equipe:</strong>
    <%= evento.equipe %>
  </div>

  <div>
    <strong>Observacoes:</strong>
    <%= evento.observacoes %>
  </div>

</div>
